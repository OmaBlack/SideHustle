{
  "name": "@sidehustle/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./seed": "./src/seed/index.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "db:reset": "tsx --env-file-if-exists=../../.env src/reset.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/seed/run.ts",
    "db:check": "drizzle-kit check",
    "test": "vitest run",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@sidehustle/pricing": "workspace:*",
    "drizzle-orm": "^0.45.0",
    "postgres": "^3.4.5",
    "uuidv7": "^1.0.2"
  },
  "devDependencies": {
    "@sidehustle/config": "workspace:*",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8",
    "@types/node": "^22.10.2"
  }
}
