{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "test": {
      "dependsOn": ["transit"],
      "env": ["TEST_DATABASE_URL", "TEST_REDIS_URL"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["transit"],
      "env": ["TEST_DATABASE_URL", "TEST_REDIS_URL"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "@sidehustle/api#test": {
      "dependsOn": ["transit", "@sidehustle/db#test"],
      "env": ["TEST_DATABASE_URL", "TEST_REDIS_URL"],
      "outputs": []
    }
  },
  "globalPassThroughEnv": [
    "CI",
    "DATABASE_URL",
    "REDIS_URL",
    "PLAYWRIGHT_CHROMIUM_PATH",
    "WEB_PORT",
    "E2E_DATABASE_URL",
    "E2E_REDIS_URL",
    "E2E_API_PORT"
  ]
}
