# Copy to .env for local development. Values match docker-compose.yml.
NODE_ENV=development
DATABASE_URL=postgres://sidehustle:sidehustle@localhost:5432/sidehustle
REDIS_URL=redis://localhost:6379
PORT=4000
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:3000
# The web app proxies /v1 to this API origin at request time (apps/web/src/app/v1/[...path]/route.ts).
API_ORIGIN=http://localhost:4000
# Set true when the API is only reachable through the web proxy or a CDN, so rate limits see client IPs.
TRUST_PROXY=false
# Local http only; production always sets Secure cookies.
COOKIE_SECURE=false
# Password for the demo accounts made by `pnpm db:seed:demo` (never in production).
DEMO_PASSWORD=sidehustle-demo

# Integration tests (packages/db, apps/api). Skipped when unset.
TEST_DATABASE_URL=postgres://sidehustle:sidehustle@localhost:5432/sidehustle_test
TEST_REDIS_URL=redis://localhost:6379

# Object storage (MinIO locally, Cloudflare R2 in staging/production)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=sidehustle
S3_SECRET_ACCESS_KEY=sidehustle-secret
S3_PUBLIC_BUCKET=sidehustle-public
S3_PRIVATE_BUCKET=sidehustle-kyc

# Email (Mailpit locally, Resend later) and SMS (Termii, ticket 2.0)
SMTP_URL=smtp://localhost:1025
RESEND_API_KEY=
TERMII_API_KEY=

# Payments (ticket 0.9 spike / 2.4). Use Paystack test keys only.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
